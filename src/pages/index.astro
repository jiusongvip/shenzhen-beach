  description="Compare all 10 Shenzhen beaches with our interactive map, photos, transport, fees, and reviews. Find your perfect Shenzhen beach in 60 seconds."
>
  <Nav />
  <main>
    <Hero />
    <QuickNav />
    <QuickFacts />
    <VideoSection />
    <WhatIs />
    <ExperienceTimeline />
    <PersonaPicker />
    <Planner />
    <MapSection />
    <ComparisonTable />
    <CheatSheet />
    <BeachCard />
    <BeachItinerary />
    <CrowdCalendar />
    <TransportTabs />
    <SeasonalGuide />
    <NearbyAttractions />
    <VsHongKong />
    <ForeignVisitors />
    <FAQ />
    <TrustSignals />
    <ShareBar />
