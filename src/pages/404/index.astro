---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Page Not Found - Shenzhen Beaches" description="The page you are looking for does not exist. Browse our complete guide to all 10 Shenzhen beaches instead." noindex>
  <div class="min-h-[70vh] flex items-center justify-center px-4">
    <div class="text-center max-w-md">
      <p class="text-6xl mb-4">🏖️</p>
      <h1 class="text-3xl font-bold tracking-tighter mb-3">Page not found</h1>
      <p class="text-gray-600 mb-2">The page you're looking for doesn't exist.</p>
      <p class="text-gray-500 text-sm mb-8">But here are some beaches you might be looking for:</p>
      <div class="grid grid-cols-2 gap-3 mb-8 text-left">
        <a href="/beaches/dameisha" class="block p-3 rounded-lg border border-gray-200 hover:border-accent hover:bg-accent/5 transition-colors no-underline">
          <span class="font-semibold text-gray-800 text-sm">Dameisha</span>
          <span class="text-xs text-gray-400 ml-1">大梅沙</span>
          <p class="text-xs text-gray-500 mt-0.5">Easiest access · Free</p>
        </a>
        <a href="/beaches/xichong" class="block p-3 rounded-lg border border-gray-200 hover:border-accent hover:bg-accent/5 transition-colors no-underline">
          <span class="font-semibold text-gray-800 text-sm">Xichong</span>
          <span class="text-xs text-gray-400 ml-1">西涌</span>
          <p class="text-xs text-gray-500 mt-0.5">Best surf · 30 RMB</p>
        </a>
        <a href="/beaches/judiaosha" class="block p-3 rounded-lg border border-gray-200 hover:border-accent hover:bg-accent/5 transition-colors no-underline">
          <span class="font-semibold text-gray-800 text-sm">Judiaosha</span>
          <span class="text-xs text-gray-400 ml-1">桔钓沙</span>
          <p class="text-xs text-gray-500 mt-0.5">Quiet escape · Free</p>
        </a>
        <a href="/beaches/yangmeikeng" class="block p-3 rounded-lg border border-gray-200 hover:border-accent hover:bg-accent/5 transition-colors no-underline">
          <span class="font-semibold text-gray-800 text-sm">Yangmeikeng</span>
          <span class="text-xs text-gray-400 ml-1">杨梅坑</span>
          <p class="text-xs text-gray-500 mt-0.5">Scenic cycling · Free</p>
        </a>
      </div>
      <a href="/" class="inline-block px-6 py-3 rounded-full bg-accent text-white font-medium hover:bg-accent-dark transition-colors no-underline">Back to all beaches</a>
    </div>
  </div>
</Layout>
