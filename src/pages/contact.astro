---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---
<Layout title="Contact Shenzhen Beaches — Questions & Updates" description="Contact the Shenzhen Beaches team with questions, corrections, or updates about any beach listed on our site. We typically respond within 1-2 business days.">
  <Nav />
  <main class="max-w-3xl mx-auto px-4 py-12 md:py-16">
    <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-gray-900 mb-2">Contact Us</h1>
    <p class="text-gray-500 text-sm mb-8">Questions, corrections, or just want to say hi.</p>

    <div class="grid md:grid-cols-2 gap-8 mb-12">
      <div class="bg-white border border-gray-200 rounded-xl p-6">
        <h2 class="font-semibold text-ocean mb-3">General Inquiries</h2>
        <p class="text-sm text-gray-600 mb-4">Have a question about a specific beach? Found outdated information? We welcome corrections, updates, and suggestions from fellow Shenzhen beach-goers.</p>
        <a href="mailto:hello@shenzhen-beach.com" class="inline-flex items-center gap-2 px-5 py-3 bg-accent-deep text-white rounded-lg font-medium hover:bg-accent-dark transition-colors no-underline">
          <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          Email Us
        </a>
        <p class="text-xs text-gray-500 mt-3">We typically respond within 1-2 business days.</p>
      </div>

      <div class="bg-white border border-gray-200 rounded-xl p-6">
        <h2 class="font-semibold text-ocean mb-3">Beach Updates</h2>
        <p class="text-sm text-gray-600 mb-4">Know of a changed bus route, new entrance fee, or a beach condition update? Help us keep this guide accurate for everyone.</p>
        <a href="mailto:updates@shenzhen-beach.com" class="inline-flex items-center gap-2 px-5 py-3 bg-ocean text-white rounded-lg font-medium hover:opacity-90 transition-colors no-underline">
          <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
          Send an Update
        </a>
        <p class="text-xs text-gray-500 mt-3">All submissions are verified before publishing.</p>
      </div>
    </div>

    <div class="bg-sand border border-gray-200 rounded-xl p-6">
      <h2 class="font-semibold text-gray-800 mb-3">About This Guide</h2>
      <p class="text-sm text-gray-600 leading-relaxed">Shenzhen Beaches is built and maintained by Shenzhen locals who want to share honest, up-to-date information about every beach along the Dapeng Peninsula. We are not affiliated with any tourism board, resort, or government agency. <a href="/about/" class="text-ocean underline underline-offset-2">Learn more about us</a>.</p>
    </div>
  </main>
  <Footer />
</Layout>
