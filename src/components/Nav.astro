---
const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "";
const links = [
  { hash: "compare", label: "Compare" },
  { hash: "beaches", label: "Beaches" },
  { hash: "transport", label: "Transport" },
  { hash: "seasons", label: "Seasons" },
  { hash: "foreign", label: "Visitors" },
  { hash: "faq", label: "FAQ" },
];
function href(h: string) { return isHome ? "#" + h : "/#" + h; }
---
<nav class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-gray-200/60">
  <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
    <a href="/" class="text-lg font-semibold tracking-tight">
      <span class="text-accent-deep">Shenzhen</span>Beaches
    </a>
    <div class="hidden md:flex items-center gap-6 text-sm font-medium">
      {links.map(link => (
        <a href={href(link.hash)} class="text-gray-600 hover:text-accent-deep transition-colors">{link.label}</a>
      ))}
    </div>
    <button class="md:hidden text-gray-600" id="mobile-menu-btn" aria-label="Menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="20" y2="18"/></svg>
    </button>
  </div>
  <div id="mobile-menu" class="hidden md:hidden border-t border-gray-100 bg-white">
    <div class="px-4 py-3 flex flex-col gap-2">
      {links.map(link => (
        <a href={href(link.hash)} class="text-sm font-medium text-gray-600 hover:text-accent-deep py-2 transition-colors">{link.label}</a>
      ))}
    </div>
  </div>
</nav>
