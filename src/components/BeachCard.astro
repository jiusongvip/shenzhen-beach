---
import beaches from "../data/beaches.json";

const crowdColor = (level: string) => {
  if (level === "busy") return "bg-accent";
  if (level === "moderate") return "bg-amber-400";
  return "bg-ocean";
};

// Map beach IDs to available images
const beachImages: Record<string, string> = {
  dameisha: "/images/dameisha.webp",
  xichong: "/images/hero-xichong.webp",
  judiaosha: "/images/judiaosha.webp",
  dongchong: "/images/dongchong.webp",
  yangmeikeng: "/images/yangmeikeng.webp",
  jinshawan: "/images/jinshawan.webp",
  nanao: "/images/nanao.webp",
  xiaomeisha: "/images/xiaomeisha.webp",
  shuitousha: "/images/shuitousha.webp",
  shangdong: "/images/shangdong.webp",
};
---
<section id="beaches" class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4">
    <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-2">Explore Every Beach</h2>
    <p class="text-gray-500 mb-8 max-w-xl">Click any card to see the full guide: transport, food, hotels, packing list, and more.</p>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {beaches.map(b => (
        <a
          id={`card-${b.id}`}
          href={`/beaches/${b.slug}/`}
          class="group block border border-gray-200 rounded-xl overflow-hidden bg-white transition-all duration-200 hover:border-accent/40 hover:shadow-lg hover:-translate-y-0.5"
        >
          <!-- Beach Photo -->
          {beachImages[b.id] ? (
            <div class="aspect-[16/10] overflow-hidden bg-gray-100">
              <img src={beachImages[b.id]} srcset={`${beachImages[b.id].replace('.webp', '-400w.webp')} 400w, ${beachImages[b.id]} 800w`} sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw" alt={`${b.name} Beach (${b.nameCN})`} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" width="800" height="534" loading="lazy" decoding="async" />
            </div>
          ) : (
            <div class={`aspect-[16/10] flex items-center justify-center ${b.id === "shuitousha" ? "bg-gradient-to-br from-ocean/20 to-ocean/5" : "bg-gradient-to-br from-sand-dark/50 to-sand/30"}`}>
              <span class="text-2xl opacity-30">{b.nameCN}</span>
            </div>
          )}
          <div class="px-5 py-4">
            <div class="flex items-center gap-2 flex-wrap mb-2">
              <h3 class="text-lg font-semibold text-gray-900 group-hover:text-accent transition-colors">{b.name}</h3>
              <span class="text-sm text-gray-400">{b.nameCN}</span>
              <span class={`w-2 h-2 rounded-full flex-shrink-0 ${crowdColor(b.crowdLevel)}`}></span>
            </div>
            <div class="flex items-center gap-3 text-sm text-gray-500 flex-wrap mb-2">
              <span>{b.distance}</span>
              <span>{b.fee}</span>
              <span class="flex items-center gap-1">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="#e0683a"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                {b.rating}
              </span>
              <span>{b.crowdLabel}</span>
            </div>
            <p class="text-gray-600 text-sm line-clamp-2">{b.description}</p>
            <div class="flex flex-wrap gap-1.5 mt-3">
              {(b.bestFor || []).slice(0, 3).map((tag: string) => (
                <span class="text-xs px-2 py-0.5 rounded-full bg-sand text-gray-600">{tag}</span>
              ))}
            </div>
            <div class="mt-3 pt-3 border-t border-gray-100 flex items-center justify-between">
              <div class="flex gap-3 text-xs text-gray-400">
                <span class="flex items-center gap-0.5">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h18M12 3l-4 9h8l-4 9"/></svg>
                  Transport
                </span>
                <span class="flex items-center gap-0.5">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8h1a4 4 0 010 8h-1M6 8H5a4 4 0 000 8h1M2 12h20"/></svg>
                  Food
                </span>
                <span class="flex items-center gap-0.5">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg>
                  Stay
                </span>
                <span class="flex items-center gap-0.5">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                  Pack
                </span>
              </div>
              <span class="text-xs font-medium text-accent group-hover:translate-x-0.5 transition-transform inline-flex items-center gap-1">
                Full guide
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

