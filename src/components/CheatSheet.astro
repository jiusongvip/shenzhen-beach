---
const beachesForSheet = [
  { name: "Dameisha", cn: "大梅沙", fee: "Free", rating: "4.2", bestFor: "Swimming, Family", crowd: "Busy" },
  { name: "Xiaomeisha", cn: "小梅沙", fee: "CNY 50", rating: "4.0", bestFor: "Resort, Relaxing", crowd: "Moderate" },
  { name: "Xichong", cn: "西涌", fee: "CNY 30", rating: "4.5", bestFor: "Surfing, Scenery", crowd: "Moderate" },
  { name: "Dongchong", cn: "东涌", fee: "CNY 20", rating: "4.3", bestFor: "Hiking, Surfing", crowd: "Quiet" },
  { name: "Yangmeikeng", cn: "杨梅坑", fee: "Free", rating: "4.4", bestFor: "Cycling, Photos", crowd: "Moderate" },
  { name: "Jinshawan", cn: "金沙湾", fee: "Free", rating: "4.1", bestFor: "Luxury, Resort", crowd: "Quiet" },
  { name: "Judiaosha", cn: "桔钓沙", fee: "Free", rating: "4.6", bestFor: "Romantic, Quiet", crowd: "Quiet" },
  { name: "Nanao", cn: "南澳", fee: "Free", rating: "3.8", bestFor: "Seafood, Local", crowd: "Moderate" },
  { name: "Shuitousha", cn: "水头沙", fee: "Free", rating: "3.5", bestFor: "Peace, Seclusion", crowd: "Quiet" },
  { name: "Shangdong", cn: "上洞", fee: "Free", rating: "3.2", bestFor: "Off-path, Local", crowd: "Quiet" },
];
---
<section id="cheatsheet" class="py-16 bg-white">
  <div class="max-w-4xl mx-auto px-4">
    <div class="bg-gradient-to-br from-ocean/5 to-accent/5 rounded-2xl border border-gray-200 p-6 md:p-8">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
        <div>
          <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-1">Beach Cheat Sheet</h2>
          <p class="text-gray-500 text-sm">All 10 beaches at a glance — save to your phone or print before your trip.</p>
        </div>
        <button
          id="print-cheatsheet"
          class="inline-flex items-center gap-2 px-4 py-2.5 bg-accent text-white text-sm font-medium rounded-lg hover:bg-accent-dark transition-colors cursor-pointer border-none"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9V2h12v7M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
          Print / Save
        </button>
      </div>

      <div id="cheatsheet-content" class="overflow-x-auto">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="border-b-2 border-gray-300 text-left">
              <th class="py-2 pr-3 font-semibold text-gray-800">Beach</th>
              <th class="py-2 pr-3 font-semibold text-gray-800 hidden sm:table-cell">Chinese</th>
              <th class="py-2 pr-3 font-semibold text-gray-800">Fee</th>
              <th class="py-2 pr-3 font-semibold text-gray-800">Rating</th>
              <th class="py-2 pr-3 font-semibold text-gray-800 hidden md:table-cell">Best For</th>
              <th class="py-2 font-semibold text-gray-800">Crowds</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {beachesForSheet.map((b, i) => (
              <tr class={i % 2 === 0 ? "bg-white" : "bg-sand/50"}>
                <td class="py-2.5 pr-3 font-medium text-gray-800"><a href={`/beaches/${b.name.toLowerCase()}`} class="text-ocean hover:underline no-underline">{b.name}</a></td>
                <td class="py-2.5 pr-3 text-gray-500 hidden sm:table-cell">{b.cn}</td>
                <td class="py-2.5 pr-3 text-gray-600">{b.fee}</td>
                <td class="py-2.5 pr-3"><span class="inline-flex items-center gap-0.5 text-gray-700"><svg width="12" height="12" viewBox="0 0 24 24" fill="#e0683a"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>{b.rating}</span></td>
                <td class="py-2.5 pr-3 text-gray-600 hidden md:table-cell">{b.bestFor}</td>
                <td class="py-2.5"><span class={`inline-block w-2 h-2 rounded-full mr-1.5 ${b.crowd === "Busy" ? "bg-accent" : b.crowd === "Moderate" ? "bg-amber-400" : "bg-ocean"}`}></span><span class="text-gray-600 text-xs">{b.crowd}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="text-xs text-gray-400 mt-4">shenzhen-beach.com · Verified August 2026 · Not affiliated with any tourism board</p>
    </div>
  </div>
</section>

<script>
  document.getElementById("print-cheatsheet")?.addEventListener("click", () => {
    const content = document.getElementById("cheatsheet-content")?.cloneNode(true);
    if (!content) return;
    const win = window.open("", "_blank", "width=800,height=600");
    if (!win) return;
    win.document.write(`
      <!DOCTYPE html>
      <html><head><title>Shenzhen Beach Cheat Sheet</title>
      <style>
        body { font-family: -apple-system, sans-serif; padding: 20px; color: #1a1a1a; }
        h1 { font-size: 20px; margin-bottom: 4px; }
        h2 { font-size: 18px; margin-bottom: 4px; }
        table { width: 100%; border-collapse: collapse; font-size: 13px; }
        th { text-align: left; padding: 8px 6px; border-bottom: 2px solid #ccc; }
        td { padding: 6px; border-bottom: 1px solid #eee; }
        .footer { font-size: 10px; color: #999; margin-top: 16px; }
        @media print { body { padding: 0; } }
      </style></head><body>
      <h2>Shenzhen Beach Cheat Sheet</h2>
      <p style="font-size:12px;color:#666;margin:0 0 12px">shenzhen-beach.com · August 2026</p>
      ${content.outerHTML}
      <p class="footer">shenzhen-beach.com · Verified August 2026</p>
      </body></html>
    `);
    win.document.close();
    win.print();
  });
</script>
